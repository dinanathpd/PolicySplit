# --- Editor / OS / tooling -------------------------------------
.vscode/
.idea/
.DS_Store
*.swp
.playwright-mcp/
.github/
# Scratch and the Tofino model's runtime directory (topology/tofino_model.sh).
tmp/

# --- Documentation and manuscripts -----------------------------
# Only the top-level README is published; drafts, agent notes and
# submission sources stay local.
*.md
!README.md
prompts.tx
reports/
deliverables/
notebooks/

# --- Datasets --------------------------------------------------
# CICIoT2023 and every artifact derived from it must be obtained
# from the CIC portal and regenerated with scripts/download_pcap.py
# and scripts/pcap_to_entropy_fast.py.
data/
data_full/
dataset/
dataset_cic_iot_2023/
dataset_unsw_nb15/
*.pcap
*.pcapng
*.h5
*.hdf5
*.npz
*.npy
*.csv
*.parquet

# --- Trained artifacts -----------------------------------------
# Checkpoints are too large for the repository; they ship in the
# reviewer artifact. The deployed adjudicator is small and tracked
# (p4/generated/controller_model.json).
models/
p4/weights/

